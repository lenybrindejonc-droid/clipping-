# Clé API Claude (https://console.anthropic.com) — sans clé, un mode de sélection basique est utilisé
ANTHROPIC_API_KEY=
# Transcription en ligne rapide (gratuit) : crée une clé sur https://console.groq.com/keys
GROQ_API_KEY=
# Transcription locale si pas de clé Groq — tiny | base (rapide) | small (plus précis, 2-3x plus lent) | medium | large-v3  (plus gros = plus précis mais plus lent)
WHISPER_MODEL=base
# Police des sous-titres (doit être installée sur la machine)
SUBTITLE_FONT=Inter
# Identités essayées auprès de YouTube (utile si un serveur se fait couper la connexion)
YT_PLAYER_CLIENTS=tv,ios,web_safari,android
# 1 = garder la vidéo source téléchargée
KEEP_SOURCE=0
